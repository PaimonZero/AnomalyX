APP_ENV=development
APP_NAME=AnomalyX
API_HOST=127.0.0.1
API_PORT=8000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EXPLANATION_LANGUAGE=vi,en

MOCK_ML_ENABLED=true
MOCK_ML_SEED=42

# Real ML model (set MOCK_ML_ENABLED=false to activate)
# Paths are relative to where the API process starts (repo root when run via docker-compose)
MODEL_PATH=ml/models/artifacts/xgb_aml_v1.json
MODEL_CONFIG_PATH=ml/models/artifacts/model_config.json

RISK_THRESHOLD_MEDIUM=0.40
RISK_THRESHOLD_FLAG=0.70
# Deprecated legacy fallback; used only when RISK_THRESHOLD_FLAG is unset.
RISK_THRESHOLD_HIGH=0.70
AUTH_TOKEN=<AUTH_TOKEN>

# Primary persistence backend: postgres. Use in_memory for quick local tests.
ALERT_REPOSITORY=postgres

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anomalyx
POSTGRES_USER=anomalyx_user
POSTGRES_PASSWORD=anomalyx_password
POSTGRES_SSLMODE=disable
# DATABASE_URL is built from POSTGRES_* by default. Set only to override.

# Optional legacy Supabase adapter (only required when ALERT_REPOSITORY=supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_RETRY_ATTEMPTS=2
REDIS_RETRY_BACKOFF_BASE_SECONDS=0.05
REDIS_RETRY_BACKOFF_CAP_SECONDS=0.5
IDEMPOTENCY_STORE=redis
IDEMPOTENCY_TTL_SECONDS=86400

JWT_SECRET_KEY=<JWT_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
METRICS_ENABLED=true
